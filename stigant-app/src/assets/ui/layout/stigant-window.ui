<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>

  <object class="GtkHeaderBar" id="header_bar">
    <property name="show-close-button">True</property>

    <child>
      <object class="GtkBox">
        <property name="spacing">14</property>
        <style><class name="brand"/></style>
        <child><object class="GtkImage"><property name="resource">/org/stigant/App/icons/stigant-logo-24.svg</property></object></child>
        <child><object class="GtkLabel"><property name="label">Stigant</property></object></child>
      </object>
    </child>

    <child type="title">
      <object class="GtkStack" id="header_stack">
        <property name="transition-type">crossfade</property>
        <property name="transition-duration">250</property>
        <property name="hhomogeneous">False</property>
        <property name="interpolate-size">True</property>
      </object>
    </child>
  </object>

  <object class="GtkStack" id="content_stack">
    <property name="transition-type">crossfade</property>
    <property name="transition-duration">100</property>
  </object>
</interface>
