<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkScrolledWindow" id="gen_result">
    <property name="hscrollbar-policy">never</property>

    <child>
      <object class="GtkBox">
        <property name="spacing">22</property>
        <property name="margin-start">32</property>
        <property name="margin-end">32</property>
        <property name="margin-top">11</property>
        <property name="margin-bottom">54</property>

        <child>
          <object class="GtkBox" id="grid_slot">
            <property name="hexpand">True</property>
            <property name="valign">start</property>
            <style><class name="card"/><class name="paper"/></style>
          </object>
        </child>

        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="width-request">432</property>
            <property name="hexpand">False</property>
            <property name="valign">start</property>
            <style><class name="card"/><class name="gen-side"/></style>

            <child><object class="GtkLabel"><property name="label">Mots à trouver</property><property name="xalign">0</property><style><class name="side-title"/></style></object></child>
            <child>
              <object class="GtkLabel">
                <property name="label">Active les solutions pour repérer chaque mot dans la grille.</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="max-width-chars">34</property>
                <property name="margin-top">5</property>
                <property name="margin-bottom">19</property>
                <style><class name="side-desc"/></style>
              </object>
            </child>

            <child>
              <object class="GtkFlowBox" id="words_box">
                <property name="selection-mode">none</property>
                <property name="max-children-per-line">10</property>
                <property name="column-spacing">8</property>
                <property name="row-spacing">8</property>
              </object>
            </child>

            <!-- Stats -->
            <child>
              <object class="GtkBox">
                <property name="homogeneous">True</property>
                <property name="margin-top">24</property>
                <style><class name="stats"/></style>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <style><class name="stat"/></style>
                    <child><object class="GtkLabel" id="stat_words"><property name="label">0</property><property name="xalign">0</property><style><class name="stat-value"/></style></object></child>
                    <child><object class="GtkLabel"><property name="label">mots</property><property name="xalign">0</property><style><class name="stat-label"/></style></object></child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <style><class name="stat"/><class name="bordered"/></style>
                    <child><object class="GtkLabel" id="stat_cells"><property name="label">144</property><property name="xalign">0</property><style><class name="stat-value"/></style></object></child>
                    <child><object class="GtkLabel"><property name="label">cases</property><property name="xalign">0</property><style><class name="stat-label"/></style></object></child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <style><class name="stat"/><class name="bordered"/></style>
                    <child><object class="GtkLabel" id="stat_dirs"><property name="label">4</property><property name="xalign">0</property><style><class name="stat-value"/></style></object></child>
                    <child><object class="GtkLabel"><property name="label">sens</property><property name="xalign">0</property><style><class name="stat-label"/></style></object></child>
                  </object>
                </child>
              </object>
            </child>

            <!-- Actions -->
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="margin-top">24</property>
                <style><class name="side-actions"/></style>
                <child>
                  <object class="GtkBox">
                    <property name="margin-bottom">19</property>
                    <child><object class="GtkLabel"><property name="label">Afficher les solutions</property><property name="xalign">0</property><property name="hexpand">True</property></object></child>
                    <child>
                      <object class="GtkSwitch" id="sol_switch">
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <style><class name="pill"/><class name="dark"/></style>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">12</property>
                        <property name="halign">center</property>
                        <child><object class="GtkImage"><property name="resource">/org/stigant/App/icons/stigant-download-light.svg</property></object></child>
                        <child><object class="GtkLabel"><property name="label">Télécharger en PDF</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">11</property>
                    <property name="homogeneous">True</property>
                    <property name="margin-top">11</property>
                    <child>
                      <object class="GtkButton">
                        <style><class name="pill"/><class name="line"/></style>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <property name="halign">center</property>
                            <child><object class="GtkImage"><property name="resource">/org/stigant/App/icons/stigant-shuffle.svg</property></object></child>
                            <child><object class="GtkLabel"><property name="label">Mélanger</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton">
                        <style><class name="pill"/><class name="line"/></style>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">12</property>
                            <property name="halign">center</property>
                            <child><object class="GtkImage"><property name="resource">/org/stigant/App/icons/stigant-print.svg</property></object></child>
                            <child><object class="GtkLabel"><property name="label">Imprimer</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        
      </object>
    </child>
  </object>
</interface>
